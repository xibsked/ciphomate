# Replace with the regional endpoint configured for your Tuya project.
HOST=https://your-tuya-api-host
CLIENT_ID=replace-with-client-id
SECRET=replace-with-client-secret
PUMP_DEVICE_ID=replace-with-pump-device-id
TANK_DEVICE_ID=replace-with-tank-device-id

START_TIME=06:00
STOP_TIME=22:00
TZ=Asia/Kolkata
LOG_LEVEL=info
STOP_GRACE_SECONDS=12

MAX_RETRIES=2
RETRY_DELAY=30m
PUMP_CURRENT_THRESHOLD=5000
TANK_CURRENT_THRESHOLD=100
LOW_CURRENT_MINUTES=2
MONITOR_INTERVAL=1m
